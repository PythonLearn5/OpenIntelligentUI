# Agent settings: place these in apps/agent/.env.
# Use the key for the selected provider; never expose keys to the browser.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# chat-latest follows ChatGPT Instant. gpt-* uses OpenAI; claude-* uses Anthropic.
# Model access/availability must be verified with your provider.
# Blank or unsupported model prefixes fail at startup.
# Keys are optional for BYOK-only hosting; visitors enter both keys in the app.
LLM_MODEL=chat-latest

# Jev selects the renderer and visualization before each new user turn.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# ============================================================================
# Vercel AI Gateway / Custom Base URL Support (optional, keep unset for direct
# official provider endpoints)
#
# Endpoint precedence (highest first):
#   1. Provider-specific *_BASE_URL overrides below.
#   2. Shared AI_GATEWAY_URL (applies to all providers whenever the dedicated
#      override above it is not also set).
#   3. Provider's canonical production endpoint (fallback).
#
# For Vercel AI Gateway, set AI_GATEWAY_URL to the gateway origin and leave
# the individual *_BASE_URL entries blank. The gateway routes per-model using
# the original provider auth headers sent by this agent (your gateway must
# accept those credentials or map them via its own rules).
# ============================================================================

# Shared gateway origin. Typical Vercel AI Gateway format:
#   AI_GATEWAY_URL=https://gateway.ai-sdk.com/v1
AI_GATEWAY_URL=

# Provider-specific overrides. Leave blank to fall through to AI_GATEWAY_URL
# (when set) or the official provider endpoint.
OPENAI_BASE_URL=         # e.g. https://<your-gateway>/v1  or a proxy/Azure OpenAI endpoint
ANTHROPIC_BASE_URL=      # e.g. https://<your-gateway>     (LangChain ChatAnthropic base_url)
TYPESAFE_BASE_URL=       # e.g. https://<your-gateway>/v1/systemone  for Jev routing

# Frontend settings: place these in apps/app/.env.local.
# LANGGRAPH_DEPLOYMENT_URL defaults to http://localhost:8123.
# LANGGRAPH_DEPLOYMENT_URL=http://localhost:8123
# MCP_SERVER_URL=http://localhost:3100/mcp

# Rate limiting (per IP) — disabled by default
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=40
