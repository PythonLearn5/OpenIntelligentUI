{
  "name": "copilotkit-langgraph-template",
  "private": true,
  "workspaces": [
    "apps/app",
    "apps/mcp",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"turbo run dev\" \"yarn run dev:agent\" --names turbo,agent --kill-others",
    "dev:app": "turbo run dev --filter='@repo/app'",
    "dev:agent": "cd apps/agent && uv sync && uv run uvicorn main:app --host 0.0.0.0 --port 8123 --reload",
    "dev:mcp": "turbo run dev --filter='open-intelligent-ui-mcp'",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "concurrently": "^9.1.2",
    "rimraf": "^6.0.0"
  },
  "packageManager": "yarn@4.5.0",
  "resolutions": {
    "esbuild": "^0.27.3"
  }
}
